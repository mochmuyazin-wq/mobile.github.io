{
  "expo": {
    "name": "DompetKita",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.jointwallet.ina2cn",
      "infoPlist": {
        "NSCameraUsageDescription": "Foto struk untuk bukti transaksi",
        "NSPhotoLibraryUsageDescription": "Pilih struk dari galeri Anda"
      }
    },
    "android": {
  
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.jointwallet.ina2cn",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Foto struk untuk bukti transaksi",
          "photosPermission": "Pilih struk dari galeri Anda"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54dce07b-4e35-4e2e-a573-fcac926fb708"
      }
    }
  }
}
